@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The interface target links coin_bievr::coin_bievr (which transitively provides
# Eigen/Ceres/TBB), so resolve the core package before importing our target.
if(NOT TARGET coin_bievr::coin_bievr)
  find_dependency(coin_bievr)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/coin_bievr_ros_commonTargets.cmake")

check_required_components(coin_bievr_ros_common)
